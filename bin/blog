#!/usr/bin/env bash
# blog — the one-command writing-cockpit launcher.
#
# Opens cool-retro-term fullscreen, in ~/writing, running WordGrinder.
# One action -> you're in the phosphor glow, writing.
#
# The look (amber / green / blue / etc.) is chosen with `crt-theme`. That tool
# writes cool-retro-term's settings DB, so whatever theme you last applied is
# what `blog` launches with. The --profile flag is NOT used (it is broken in
# cool-retro-term 1.2.0).

set -euo pipefail

WRITING_DIR="${RETRO_WRITER_DIR:-$HOME/writing}"

mkdir -p "$WRITING_DIR"

# -e CATCHES ALL FOLLOWING ARGS, so `-e wordgrinder` MUST be the last option.
exec cool-retro-term \
	--fullscreen \
	--workdir "$WRITING_DIR" \
	-e wordgrinder
